ninja_required_version = 1.3
cxx = c++
nvcc = /usr/local/cuda-11.8/bin/nvcc

cflags = -pthread -B /home/ycx/anaconda3/envs/EGG/compiler_compat -Wno-unused-result -Wsign-compare -DNDEBUG -O2 -Wall -fPIC -O2 -isystem /home/ycx/anaconda3/envs/EGG/include -I/home/ycx/anaconda3/envs/EGG/include -fPIC -O2 -isystem /home/ycx/anaconda3/envs/EGG/include -fPIC -I/home/ycx/anaconda3/envs/EGG/lib/python3.9/site-packages/torch/include -I/home/ycx/anaconda3/envs/EGG/lib/python3.9/site-packages/torch/include/torch/csrc/api/include -I/home/ycx/anaconda3/envs/EGG/lib/python3.9/site-packages/torch/include/TH -I/home/ycx/anaconda3/envs/EGG/lib/python3.9/site-packages/torch/include/THC -I/usr/local/cuda-11.8/include -I/home/ycx/anaconda3/envs/EGG/include/python3.9 -c
post_cflags = -g -DTORCH_API_INCLUDE_EXTENSION_H '-DPYBIND11_COMPILER_TYPE="_gcc"' '-DPYBIND11_STDLIB="_libstdcpp"' '-DPYBIND11_BUILD_ABI="_cxxabi1011"' -DTORCH_EXTENSION_NAME=fps_cuda -D_GLIBCXX_USE_CXX11_ABI=0 -std=c++17
cuda_cflags = -I/home/ycx/anaconda3/envs/EGG/lib/python3.9/site-packages/torch/include -I/home/ycx/anaconda3/envs/EGG/lib/python3.9/site-packages/torch/include/torch/csrc/api/include -I/home/ycx/anaconda3/envs/EGG/lib/python3.9/site-packages/torch/include/TH -I/home/ycx/anaconda3/envs/EGG/lib/python3.9/site-packages/torch/include/THC -I/usr/local/cuda-11.8/include -I/home/ycx/anaconda3/envs/EGG/include/python3.9 -c
cuda_post_cflags = -D__CUDA_NO_HALF_OPERATORS__ -D__CUDA_NO_HALF_CONVERSIONS__ -D__CUDA_NO_BFLOAT16_CONVERSIONS__ -D__CUDA_NO_HALF2_OPERATORS__ --expt-relaxed-constexpr --compiler-options ''"'"'-fPIC'"'"'' -O2 -DTORCH_API_INCLUDE_EXTENSION_H '-DPYBIND11_COMPILER_TYPE="_gcc"' '-DPYBIND11_STDLIB="_libstdcpp"' '-DPYBIND11_BUILD_ABI="_cxxabi1011"' -DTORCH_EXTENSION_NAME=fps_cuda -D_GLIBCXX_USE_CXX11_ABI=0 -gencode=arch=compute_75,code=compute_75 -gencode=arch=compute_75,code=sm_75 -std=c++17
cuda_dlink_post_cflags = 
ldflags = 

rule compile
  command = $cxx -MMD -MF $out.d $cflags -c $in -o $out $post_cflags
  depfile = $out.d
  deps = gcc

rule cuda_compile
  depfile = $out.d
  deps = gcc
  command = $nvcc  $cuda_cflags -c $in -o $out $cuda_post_cflags





build /home/ycx/code/EGIInet-analy/utils/furthestPointSampling/build/temp.linux-x86_64-cpython-39/sampling.o: compile /home/ycx/code/EGIInet-analy/utils/furthestPointSampling/sampling.cpp
build /home/ycx/code/EGIInet-analy/utils/furthestPointSampling/build/temp.linux-x86_64-cpython-39/sampling_gpu.o: cuda_compile /home/ycx/code/EGIInet-analy/utils/furthestPointSampling/sampling_gpu.cu






